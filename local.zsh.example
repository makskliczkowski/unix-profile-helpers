# Machine-specific shell settings.
#
# The deployer installs this as ~/.config/zsh/local.zsh only when that file does
# not already exist. Keep private paths here and never commit credentials.

# Safe interactive defaults (common-safety.sh). Set to 0 to disable.
# UPH_SAFE=1
# Default umask is 077 (private files); use 027 to share with your group.
# UPH_UMASK=077

# Oh My Zsh (optional).
# ZSH="$HOME/.oh-my-zsh"
# ZSH_THEME="robbyrussell"
# typeset -ga UPH_EXTRA_PLUGINS=(kubectl)

# Editor override; the default depends on SSH and installed tools.
# export EDITOR='code --wait'
